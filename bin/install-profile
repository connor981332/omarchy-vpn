#!/bin/bash
#
# The plugin's only privileged operation besides `systemctl start`. Invoked as
# `pkexec /path/to/install-profile <verb> ...`, so it authenticates through the
# running polkit agent and holds no persistent privilege.
#
# It exists because the openvpn package ships
# `d /etc/openvpn/client 0750 openvpn network` in its tmpfiles, so the profile
# directory is unreadable and unwritable by a normal user on every Arch
# install — the widget cannot put a file there, list what is there, or delete
# from there without becoming root for exactly that moment.
#
# Everything it is asked to do is deliberately dumb. The caller is
# unprivileged and therefore untrusted, so:
#   - the destination directory is chosen HERE from a protocol token, never
#     taken from the caller;
#   - the profile name must match a strict pattern, so it cannot traverse;
#   - the staging directory is copied into a root-owned one FIRST, without
#     following symlinks, and only that copy is inspected and installed, so
#     nothing the caller does afterwards can change what root reads;
#   - the config is scanned for the directives that would let its author
#     choose what root runs, and refused if it carries any.
#
# Usage:
#   install-profile install <protocol> <name> <staging-dir>
#   install-profile remove  <protocol> <name>
#   install-profile list    <protocol>
#   install-profile set-credentials   <protocol> <name>   # reads stdin
#   install-profile clear-credentials <protocol> <name>
#
# `set-credentials` takes the username and password as the first two lines of
# STDIN and never as arguments. /proc/<pid>/cmdline is world-readable, so an
# argument is visible to every process on the machine for as long as this one
# runs — a secret passed that way is disclosed no matter what the file it ends
# up in is chmodded to.

set -euo pipefail

die() {
  echo "install-profile: $*" >&2
  exit 1
}

# --------------------------------------------------------------- destinations
#
# The one place in the plugin outside backends/ that names a protocol, and it
# is load-bearing: a caller that could pick the directory could write anywhere.
profile_dir() {
  case "$1" in
    openvpn) echo "/etc/openvpn/client" ;;
    wireguard) echo "/etc/wireguard" ;;
    *) die "unknown protocol '$1'" ;;
  esac
}

profile_owner() {
  case "$1" in
    openvpn) echo "openvpn:network" ;;
    wireguard) echo "root:root" ;;
    *) die "unknown protocol '$1'" ;;
  esac
}

profile_ext() {
  echo "conf"
}

# Credentials live beside the profile as `<name>.auth`, which is the format
# OpenVPN's own `auth-user-pass <file>` expects: username on line one,
# password on line two, nothing else. No invented encoding to audit, and the
# file is picked up by a reconnect with no session and no UI.
#
# `<name>.auth` also sorts under the `$name.*` glob that cmd_remove already
# walks, so deleting a profile deletes its credentials without a second rule
# that could drift out of step with this one.
credential_ext() {
  echo "auth"
}

# Which protocols have a credential file at all. WireGuard authenticates with
# keys that are already in the config, so there is nothing to store and a
# request to store some is a caller bug worth refusing loudly.
profile_has_credentials() {
  case "$1" in
    openvpn) return 0 ;;
    wireguard) return 1 ;;
    *) die "unknown protocol '$1'" ;;
  esac
}

# ------------------------------------------------------- unsafe directives
#
# The second enforcement of the lists in backends/*/Config.js. That one runs
# as the user, which makes it a convenience rather than a control: by the time
# we are here the staged config is just bytes the caller produced, and the only
# thing standing between "install a VPN profile" and "run this as root" is this
# function. The two must agree — if a directive is added there, add it here.
#
# The unit runs the VPN daemon as root, so each of these hands the author of a
# downloaded profile either code execution (a script hook, a plugin) or a file
# write at a path they choose.
OPENVPN_UNSAFE="up down route-up route-pre-down ipchange client-connect \
client-disconnect learn-address tls-verify auth-user-pass-verify \
tls-crypt-v2-verify plugin script-security log log-append status writepid"

WIREGUARD_UNSAFE="preup postup predown postdown"

# Refuses the config if it carries one. Reads the file that is about to be
# installed, from the root-owned copy — never the caller's own.
reject_unsafe_directives() {
  local protocol="$1" file="$2" found=""

  case "$protocol" in
    openvpn)
      # Inline blocks (<ca>…</ca>) are skipped: a PEM body is data, and a
      # base64 line that happened to start with a keyword would otherwise
      # refuse a perfectly good profile. A leading `--` is stripped because
      # OpenVPN accepts a directive spelled either way in a config file, and
      # so does the parser this list mirrors.
      found="$(awk -v keys=" $OPENVPN_UNSAFE " '
        /^[[:space:]]*<\/?[A-Za-z0-9_-]+>[[:space:]]*$/ {
          if ($0 ~ /^[[:space:]]*<\//) { inline = 0 } else { inline = 1 }
          next
        }
        inline { next }
        {
          key = $1
          gsub(/"/, "", key)
          sub(/^--/, "", key)
          if (key != "" && index(keys, " " key " ") > 0) print key
        }
      ' "$file" | sort -u | tr '\n' ' ')"
      ;;
    wireguard)
      found="$(awk -v keys=" $WIREGUARD_UNSAFE " '
        {
          line = $0
          sub(/=.*$/, "", line)
          gsub(/[[:space:]]/, "", line)
          key = tolower(line)
          if (key != "" && index($0, "=") > 0 && index(keys, " " key " ") > 0) print key
        }
      ' "$file" | sort -u | tr '\n' ' ')"
      ;;
    *) die "unknown protocol '$protocol'" ;;
  esac

  [[ -z ${found// /} ]] \
    || die "refusing to install: the config carries ${found% } — a directive that would let it run commands or write files as root"
}

# Everything a staging directory must be before a single file is installed
# from it. Called on the root-owned copy, never on the caller's own — see
# cmd_install — and a separate function so test/helper.test.sh can exercise it
# without the root that the rest of cmd_install needs.
#
# Vets the whole directory before writing anything: a partial install leaves a
# profile that starts and then fails on a missing cert.
vet_staging_dir() {
  local protocol="$1" name="$2" dir="$3"
  local ext entry base
  ext="$(profile_ext "$protocol")"

  # The config itself must be present, and must be named for the profile, so
  # the unit's `--config %i.conf` finds it.
  [[ -f "$dir/$name.$ext" && ! -L "$dir/$name.$ext" ]] \
    || die "staging directory has no $name.$ext"

  for entry in "$dir"/*; do
    [[ -e $entry || -L $entry ]] || continue
    base="$(basename "$entry")"
    [[ ! -L $entry ]] || die "'$base' is a symlink"
    [[ -f $entry ]] || die "'$base' is not a regular file"
    [[ $base == "$name" || $base == "$name".* ]] \
      || die "'$base' does not belong to profile '$name'"
  done

  # The config is the caller's bytes, and the daemon that reads it runs as
  # root. This is the last point at which that can be refused.
  reject_unsafe_directives "$protocol" "$dir/$name.$ext"
}

# A profile name becomes a filename and a systemd instance. Anything outside
# this set is refused rather than sanitized: silently changing the name the
# caller asked for is how a delete removes the wrong file.
validate_name() {
  local name="$1"
  [[ -n $name ]] || die "empty profile name"
  [[ ${#name} -le 64 ]] || die "profile name too long"
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid profile name '$name'"
  [[ $name != *..* ]] || die "invalid profile name '$name'"
}

require_dir() {
  local dir="$1" protocol="$2"
  if [[ ! -d $dir ]]; then
    # systemd-tmpfiles owns the mode; recreating it by hand would get it wrong.
    systemd-tmpfiles --create >/dev/null 2>&1 || true
  fi
  [[ -d $dir ]] || die "$dir does not exist — is the $protocol package installed?"
}

# ------------------------------------------------------------------- verbs

cmd_install() {
  local protocol="${1-}" name="${2-}" staging="${3-}"
  [[ -n $protocol && -n $name && -n $staging ]] || die "usage: install <protocol> <name> <staging-dir>"
  validate_name "$name"

  local dir owner ext entry
  dir="$(profile_dir "$protocol")"
  owner="$(profile_owner "$protocol")"
  ext="$(profile_ext "$protocol")"
  require_dir "$dir" "$protocol"

  [[ -d $staging ]] || die "staging directory '$staging' does not exist"
  [[ ! -L $staging ]] || die "staging directory is a symlink"

  # Take our own copy before looking at anything.
  #
  # The staging directory belongs to the unprivileged caller, so every check
  # against it is a check against something that can change immediately
  # afterwards: validate an entry, and by the time `install` reopens that same
  # name it can be a symlink to a file only root can read. Copying first with
  # --no-dereference removes the window rather than narrowing it — a symlink
  # swapped in at any moment is copied AS a symlink, never followed, and then
  # fails the validation below on an object that can no longer change.
  #
  # /run, not mktemp's default: TMPDIR is an environment variable, and while
  # pkexec sanitizes the environment it hands us, a root-only directory named
  # here is one less thing that depends on it.
  local root_staging
  root_staging="$(mktemp -d /run/connor.vpn-install.XXXXXXXX)" || die "cannot create a staging directory"
  chmod 0700 "$root_staging"
  # shellcheck disable=SC2064  # $root_staging is expanded now on purpose.
  trap "rm -rf -- '$root_staging'" EXIT
  cp -R --no-dereference --preserve=mode "$staging/." "$root_staging/" \
    || die "cannot read the staging directory"

  # Everything from here reads $root_staging. Nothing reads $staging again.
  vet_staging_dir "$protocol" "$name" "$root_staging"

  # 0600: these files carry private keys and passphrases.
  for entry in "$root_staging"/*; do
    [[ -f $entry ]] || continue
    install -o "${owner%%:*}" -g "${owner##*:}" -m 0600 "$entry" "$dir/$(basename "$entry")"
  done

  echo "installed $name"
}

cmd_remove() {
  local protocol="${1-}" name="${2-}"
  [[ -n $protocol && -n $name ]] || die "usage: remove <protocol> <name>"
  validate_name "$name"

  local dir
  dir="$(profile_dir "$protocol")"
  [[ -d $dir ]] || die "$dir does not exist"

  # Stop it first, or the files vanish under a running tunnel.
  systemctl stop "$(unit_name "$protocol" "$name")" >/dev/null 2>&1 || true

  local removed=0 entry
  for entry in "$dir/$name" "$dir/$name".*; do
    [[ -f $entry && ! -L $entry ]] || continue
    rm -f -- "$entry"
    removed=$((removed + 1))
  done

  [[ $removed -gt 0 ]] || die "no profile named '$name' in $dir"
  echo "removed $name ($removed files)"
}

# Reads the two values from stdin, never from argv. Both are read with
# `read -r`, so neither can contain a newline and the two-line file cannot be
# forged into more lines than it claims to have.
cmd_set_credentials() {
  local protocol="${1-}" name="${2-}"
  [[ -n $protocol && -n $name ]] || die "usage: set-credentials <protocol> <name>"
  validate_name "$name"
  profile_has_credentials "$protocol" || die "$protocol profiles do not use stored credentials"

  local dir owner
  dir="$(profile_dir "$protocol")"
  owner="$(profile_owner "$protocol")"
  [[ -d $dir ]] || die "$dir does not exist"

  # Refuse to write credentials for a profile that is not installed: the file
  # would be invisible to the widget (it cannot list this directory) and would
  # outlive anything that knows why it is there.
  [[ -f "$dir/$name.$(profile_ext "$protocol")" ]] \
    || die "no profile named '$name' in $dir"

  local username password
  IFS= read -r username || username=""
  IFS= read -r password || password=""
  [[ -n $username ]] || die "empty username"

  # Written to a private temp file and installed over, so the destination is
  # never briefly readable and a failure part-way through leaves the previous
  # credentials intact rather than a half-written file.
  local tmp
  tmp="$(mktemp)"
  # shellcheck disable=SC2064  # $tmp is expanded now on purpose.
  trap "rm -f -- '$tmp'" EXIT
  chmod 0600 "$tmp"
  printf '%s\n%s\n' "$username" "$password" > "$tmp"
  install -o "${owner%%:*}" -g "${owner##*:}" -m 0600 "$tmp" \
    "$dir/$name.$(credential_ext)"

  echo "stored credentials for $name"
}

cmd_clear_credentials() {
  local protocol="${1-}" name="${2-}"
  [[ -n $protocol && -n $name ]] || die "usage: clear-credentials <protocol> <name>"
  validate_name "$name"
  profile_has_credentials "$protocol" || die "$protocol profiles do not use stored credentials"

  local dir file
  dir="$(profile_dir "$protocol")"
  file="$dir/$name.$(credential_ext)"
  [[ -f $file && ! -L $file ]] || die "no stored credentials for '$name'"
  rm -f -- "$file"

  echo "cleared credentials for $name"
}

cmd_list() {
  local protocol="${1-}"
  [[ -n $protocol ]] || die "usage: list <protocol>"

  local dir ext entry base
  dir="$(profile_dir "$protocol")"
  ext="$(profile_ext "$protocol")"
  [[ -d $dir ]] || exit 0

  for entry in "$dir"/*."$ext"; do
    [[ -f $entry && ! -L $entry ]] || continue
    base="$(basename "$entry" ".$ext")"
    # Never print a name the rest of the plugin would then refuse to handle.
    [[ $base =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
    echo "$base"
  done
}

# The instance name is the profile name literally — NOT systemd-escaped.
# These templates expand `%i` (the raw instance) into a filename, so the
# instance must match the file this script wrote. validate_name() has already
# restricted the name to characters that are legal in an instance as-is.
unit_name() {
  case "$1" in
    openvpn) echo "openvpn-client@$2.service" ;;
    wireguard) echo "wg-quick@$2.service" ;;
    *) die "unknown protocol '$1'" ;;
  esac
}

# ------------------------------------------------------------------- dispatch

# Sourcing this file defines its functions and runs nothing, so
# test/helper.test.sh can exercise reject_unsafe_directives on its own. That
# matters because the rest of cmd_install needs real root, and the one check
# standing between an untrusted config and root running its author's commands
# should not be the one check with no unprivileged test.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

verb="${1-}"
shift || true

case "$verb" in
  install) cmd_install "$@" ;;
  remove) cmd_remove "$@" ;;
  list) cmd_list "$@" ;;
  set-credentials) cmd_set_credentials "$@" ;;
  clear-credentials) cmd_clear_credentials "$@" ;;
  *) die "usage: install-profile {install|remove|list|set-credentials|clear-credentials} ..." ;;
esac
